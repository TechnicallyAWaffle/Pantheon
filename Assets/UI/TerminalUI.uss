.terminal-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(10, 10, 10);
    padding: 8px;
}

.terminal-scroll {
    flex-grow: 1;
    overflow: hidden;
}

.terminal-content {
    flex-direction: column;
    padding: 4px;
}

.terminal-line {
    color: rgb(0, 255, 0);
    white-space: normal;
    font-size: 36px;
    margin: 1px 0;
}

.terminal-line-user {
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Terminal%20F4.ttf?fileID=12800000&guid=b6ef52f6640b1ad45920dba66751dde8&type=3#Terminal F4");
}

.terminal-line-system {
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Terminal%20F4.ttf?fileID=12800000&guid=b6ef52f6640b1ad45920dba66751dde8&type=3#Terminal F4");
}

.terminal-line-error {
    color: rgb(255, 0, 0);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Ac437_IBM_Model30r0.ttf?fileID=12800000&guid=ffe8918a188f6554fa4d5ab1dab5eb73&type=3#Ac437_IBM_Model30r0");
}

.input-row {
    flex-direction: row;
    align-items: center;
}

.input-prompt {
    color: rgb(0, 255, 0);
    font-size: 36px;
    margin-right: 4px;
    display: none;
}

.terminal-input {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 36px;
    margin: 0;
    padding: 0;
}

.terminal-input > #unity-text-input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 36px;
    -unity-text-align: middle-left;
    padding: 0;
    margin: 0;
}

.terminal-input > #unity-text-input > :placeholder {
    color: rgb(0, 255, 0);
    opacity: 1;
}

.terminal-scroll > #unity-content-and-vertical-scroll-container > #unity-vertical-scroller {
}
