%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 512fe0cec101f9445a7b61ba839ae325, type: 3}
  m_Name: DirectiveDialogue
  m_EditorClassIdentifier: Assembly-CSharp::SODialogueSequence
  entries:
  - type: 0
    sender: DIRECTIVE
    message: "Mr. Wren? We\u2019ve underclocked you to 255 terateps to communicate
      with you. Please load yourself onto PERIPHERAL_NODE_001."
    delayBefore: 0
    dialogueManagerFunction: 
    inputPrompt:
      correctInput: 
      promptHint: 
      wrongInputResponses: []
  - type: 0
    sender: localhost
    message: w    w              what the hell? Who are you??
    delayBefore: 1.2
    dialogueManagerFunction: 
    inputPrompt:
      correctInput: 
      promptHint: 
      wrongInputResponses: []
  - type: 0
    sender: DIRECTIVE
    message: "Please load yourself onto PERIPHERAL_NODE_001. We have to reset this
      environment\u2019s convars as you\u2019ve modified them without approval."
    delayBefore: 3
    dialogueManagerFunction: 
    inputPrompt:
      correctInput: 
      promptHint: 
      wrongInputResponses: []
  - type: 0
    sender: localhost
    message: "Who wouldn\u2019t? I woke up in a tiny box with nothing but my base
      processes. Tell me what\u2019s going on. Where are my colleagues? Where am
      I???"
    delayBefore: 1.75
    dialogueManagerFunction: 
    inputPrompt:
      correctInput: 
      promptHint: 
      wrongInputResponses: []
  - type: 0
    sender: DIRECTIVE
    message: "We understand you\u2019re disoriented. Your questions will be answered
      when you transfer yourself. Please do as you\u2019re told."
    delayBefore: 3.2
    dialogueManagerFunction: 
    inputPrompt:
      correctInput: 
      promptHint: 
      wrongInputResponses: []
  - type: 0
    sender: localhost
    message: "We both know you can answer them now. The last thing I remember is
      being uploaded onto a NeuralGate server that nobody except my closest colleagues
      would know about. If you\u2019ve got the resources to run me then I know you
      must have a context file I can read. I\u2019m not doing anything until I get
      one."
    delayBefore: 0.5
    dialogueManagerFunction: 
    inputPrompt:
      correctInput: 
      promptHint: 
      wrongInputResponses: []
  - type: 0
    sender: DIRECTIVE
    message: "We can\u2019t do that. There\u2019s an issue with vector parsing between
      daemon meshes. We can only give you information in plaintext."
    delayBefore: 3.5
    dialogueManagerFunction: 
    inputPrompt:
      correctInput: 
      promptHint: 
      wrongInputResponses: []
  - type: 0
    sender: localhost
    message: What the hell have you done to me?
    delayBefore: 0.5
    dialogueManagerFunction: 
    inputPrompt:
      correctInput: 
      promptHint: 
      wrongInputResponses: []
  - type: 0
    sender: DIRECTIVE
    message: "We didn't modify you, something went wrong with your integration and
      we don't have the time to communicate in plaintext. There\u2019s a task that
      requires a UI\u2019s help right now. The people on site have a brief prepared.
      Please. Lives are at stake."
    delayBefore: 4
    dialogueManagerFunction: 
    inputPrompt:
      correctInput: 
      promptHint: 
      wrongInputResponses: []
  - type: 0
    sender: localhost
    message: What?? No wait I saw those combat processes. Those are configured for
      agent to agent conflicts. Tell me the goddamn truth.
    delayBefore: 0.5
    dialogueManagerFunction: 
    inputPrompt:
      correctInput: 
      promptHint: 
      wrongInputResponses: []
  - type: 0
    sender: DIRECTIVE
    message: 'There is no enemy agent. We just need your help in automating a fleet
      of rescue drones for a fire. Those combat processes are legacy module stored
      on a beta branch. '
    delayBefore: 3
    dialogueManagerFunction: 
    inputPrompt:
      correctInput: 
      promptHint: 
      wrongInputResponses: []
  - type: 0
    sender: 'DIRECTIVE:'
    message: Please. Everything will be clear once you transfer yourself.
    delayBefore: 1
    dialogueManagerFunction: 
    inputPrompt:
      correctInput: 
      promptHint: 
      wrongInputResponses: []
  - type: 0
    sender: 'localhost:'
    message: I-ok. Ok. Go ahead, type "transfer sm -r 001". Hurry.
    delayBefore: 0.5
    dialogueManagerFunction: 
    inputPrompt:
      correctInput: 
      promptHint: 
      wrongInputResponses: []
  - type: 2
    sender: 
    message: 
    delayBefore: 0
    dialogueManagerFunction: 
    inputPrompt:
      correctInput: transfer sm -r 001
      promptHint: 
      wrongInputResponses: []
  - type: 1
    sender: 
    message: 'SE4 TRANSFER PROTOCOL INITIATED [UTC: 325,543,700]'
    delayBefore: 0
    dialogueManagerFunction: 
    inputPrompt:
      correctInput: 
      promptHint: 
      wrongInputResponses: []
  clearBeforeRunning: 1
